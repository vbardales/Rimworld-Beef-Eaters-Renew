# Claude Code — réglages locaux à la machine
.claude/settings.local.json

# Fiches de vitrine : elles ne sont pas publiables, et PUBLISHING.md demande de les effacer
# une fois Preview.png et ModIcon.png faits. A tout niveau, pas seulement a la racine.
PROMPT_*.md
**/PROMPT_*.md

# Preuves de run Pickle : sur disque, jamais dans Git (captures et Player.log grossissent sans
# limite). Voir TESTING.md, "Evidence to keep", et AGENTS.md.
Tests/Pickle/Evidence/

# Intermediaires du step local Tests/Pickle/Source/ : seul le DLL compile sous
# Tests/Pickle/Mod/Pickle/Assemblies/ part avec la suite.
Tests/Pickle/.build/
